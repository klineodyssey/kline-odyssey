{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klineodyssey.github.io/kline-odyssey/KAIOS_INVENTORY_SCHEMA.json",
  "title": "KAIOS Inventory And Warehouse Specification Contract",
  "type": "object",
  "required": ["schema_version", "mode", "warehouse", "items", "risks", "history"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "mode": { "const": "SPECIFICATION_ONLY" },
    "warehouse": { "$ref": "#/$defs/warehouse" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "risks": { "type": "array", "uniqueItems": true, "items": { "enum": ["DAMAGE", "SPOILAGE", "OBSOLESCENCE", "CAPITAL_FREEZE", "HANDLING_DELAY", "FIRE", "THEFT"] } },
    "history": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "additionalProperties": false,
  "$defs": {
    "warehouse": {
      "type": "object",
      "required": ["warehouse_id", "owner_company", "capacity_mass", "capacity_volume", "occupied_mass", "occupied_volume", "storage_cost_rate", "insurance_cost", "condition", "simulation_only"],
      "properties": {
        "warehouse_id": { "type": "string" }, "owner_company": { "type": "string" },
        "capacity_mass": { "type": "number", "exclusiveMinimum": 0 }, "capacity_volume": { "type": "number", "exclusiveMinimum": 0 },
        "occupied_mass": { "type": "number", "minimum": 0 }, "occupied_volume": { "type": "number", "minimum": 0 },
        "storage_cost_rate": { "type": "number", "minimum": 0 }, "insurance_cost": { "type": "number", "minimum": 0 },
        "condition": { "enum": ["AVAILABLE", "DEGRADED", "CLOSED"] }, "simulation_only": { "const": true }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["item_id", "inventory_class", "owner_company", "warehouse_id", "quantity", "unit_mass", "total_mass", "unit_cost", "book_value", "storage_cost", "shelf_life", "condition", "reserved_quantity", "available_quantity", "arrival_time", "expiry_time"],
      "properties": {
        "item_id": { "type": "string" },
        "inventory_class": { "enum": ["RAW_MATERIAL", "WORK_IN_PROGRESS", "FINISHED_GOODS", "SPARE_PARTS", "RETURNED_GOODS", "SCRAP", "RECYCLED_MATERIAL"] },
        "owner_company": { "type": "string" }, "warehouse_id": { "type": "string" },
        "quantity": { "type": "number", "minimum": 0 }, "unit_mass": { "type": "number", "minimum": 0 },
        "total_mass": { "type": "number", "minimum": 0 }, "unit_cost": { "type": "number", "minimum": 0 },
        "book_value": { "type": "number", "minimum": 0 }, "storage_cost": { "type": "number", "minimum": 0 },
        "shelf_life": { "type": ["number", "null"], "minimum": 0 },
        "condition": { "enum": ["NEW", "GOOD", "DAMAGED", "SPOILED", "OBSOLETE", "QUARANTINED"] },
        "reserved_quantity": { "type": "number", "minimum": 0 }, "available_quantity": { "type": "number", "minimum": 0 },
        "arrival_time": { "type": "string", "format": "date-time" }, "expiry_time": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["event_id", "time", "type", "item_id", "quantity", "from", "to", "previous_state_hash", "next_state_hash"],
      "properties": {
        "event_id": { "type": "string" }, "time": { "type": "number", "minimum": 0 }, "type": { "type": "string" },
        "item_id": { "type": "string" }, "quantity": { "type": "number", "minimum": 0 },
        "from": { "type": ["string", "null"] }, "to": { "type": ["string", "null"] },
        "previous_state_hash": { "type": "string" }, "next_state_hash": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
