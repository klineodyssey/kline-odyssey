{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klineodyssey.github.io/kline-odyssey/KGEN-KAIOS/task_claim_schema.json",
  "title": "KAIOS Task Claim Lease",
  "description": "Backward-compatible registered-worker claims plus one bounded Human-delegated R0/R1 trial path. This schema validates public record structure only; it does not verify external authorization, identity, scope truth, time, writer uniqueness, reviewer independence or tool permission and does not activate a grant.",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "branch",
    "base_commit",
    "claimed_at",
    "lease_expires_at",
    "heartbeat",
    "report_path",
    "reviewer"
  ],
  "properties": {
    "claimant_kind": {
      "type": "string",
      "enum": ["REGISTERED_WORKER", "HUMAN_DELEGATED_TRIAL"]
    },
    "task_id": { "type": "string", "minLength": 1 },
    "work_order_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "worker_type": {
      "type": "string",
      "enum": ["Codex", "Cursor", "Claude", "Gemini", "OpenHands", "GitHub Copilot", "ChatGPT", "Deep Research", "Human Engineer"]
    },
    "candidate_public_ref": {
      "type": "string",
      "description": "Non-identifying public candidate label; the private evidence provides the real binding.",
      "pattern": "^CANDIDATE-[A-Z0-9-]{4,64}$"
    },
    "private_trial_reference_retained": { "const": true },
    "authorization_evidence": {
      "type": "object",
      "required": ["classification", "private_evidence_retained", "verification_state", "scope_complete"],
      "properties": {
        "classification": { "const": "HUMAN_AUTHORIZED_CANDIDATE" },
        "private_evidence_retained": { "const": true },
        "verification_state": {
          "type": "string",
          "enum": ["PENDING_EXTERNAL_VERIFICATION", "EXTERNALLY_VERIFIED", "REVOKED"]
        },
        "scope_complete": { "const": true }
      },
      "additionalProperties": false
    },
    "risk_level": { "type": "string", "enum": ["R0", "R1"] },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read",
          "analyze",
          "edit_allowed_paths",
          "run_tests",
          "create_test_fixtures_outside_commit",
          "git_commit_non_main",
          "git_push_non_main",
          "open_draft_pr",
          "update_draft_pr"
        ]
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "output": {
      "type": "object",
      "required": ["allowed_artifacts", "destination", "activation_state"],
      "properties": {
        "allowed_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["PATCH", "TEST_EVIDENCE", "NON_MAIN_COMMIT", "NON_MAIN_BRANCH", "DRAFT_PR", "REPORT"]
          }
        },
        "destination": {
          "type": "string",
          "enum": ["LOCAL_ONLY", "AUTHORIZED_NON_MAIN_BRANCH", "DRAFT_PR"]
        },
        "activation_state": { "const": "NOT_ACTIVATED" }
      },
      "additionalProperties": false
    },
    "single_writer": { "const": true },
    "grant_status": {
      "type": "string",
      "enum": ["ACTIVE", "REVOKED", "EXPIRED"]
    },
    "reviewer_independence_required": { "const": true },
    "status": {
      "type": "string",
      "enum": ["OPEN", "CLAIMED", "IN_PROGRESS", "REVIEW", "APPROVED", "MERGED", "DONE", "REJECTED", "FIX", "BLOCKED"]
    },
    "branch": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "minLength": 7 },
    "claimed_at": { "type": "string" },
    "lease_expires_at": { "type": "string" },
    "heartbeat": { "type": ["string", "null"] },
    "report_path": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "required": ["claimant_kind"],
        "properties": {
          "claimant_kind": { "const": "HUMAN_DELEGATED_TRIAL" }
        }
      },
      "then": {
        "required": [
          "work_order_id",
          "candidate_public_ref",
          "private_trial_reference_retained",
          "authorization_evidence",
          "risk_level",
          "allowed_paths",
          "allowed_actions",
          "forbidden_actions",
          "acceptance_criteria",
          "output",
          "single_writer",
          "grant_status",
          "reviewer_independence_required"
        ],
        "not": {
          "anyOf": [
            { "required": ["worker_id"] },
            { "required": ["worker_type"] }
          ]
        },
        "properties": {
          "status": {
            "enum": ["OPEN", "CLAIMED", "IN_PROGRESS", "REVIEW", "REJECTED", "FIX", "BLOCKED"]
          },
          "branch": { "not": { "const": "main" } },
          "base_commit": { "pattern": "^[0-9a-fA-F]{7,40}$" },
          "claimed_at": { "format": "date-time" },
          "lease_expires_at": { "format": "date-time" },
          "heartbeat": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          }
        }
      },
      "else": {
        "required": ["worker_id", "worker_type"],
        "properties": {
          "claimant_kind": { "const": "REGISTERED_WORKER" }
        }
      }
    }
  ],
  "additionalProperties": false
}
