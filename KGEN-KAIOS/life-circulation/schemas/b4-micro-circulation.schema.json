{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klineodyssey.github.io/kline-odyssey/KGEN-KAIOS/life-circulation/schemas/b4-micro-circulation.schema.json",
  "title": "KAIOS B4 Micro-Circulation Mission Candidate",
  "type": "object",
  "required": ["metadata", "repository", "identity", "coordinate", "chain", "heart", "meal", "movement", "market", "food", "waste", "publicGood", "mission", "evidenceHash"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "repository": { "$ref": "#/$defs/repository" },
    "identity": { "$ref": "#/$defs/identity" },
    "coordinate": { "$ref": "#/$defs/coordinate" },
    "chain": { "$ref": "#/$defs/chain" },
    "heart": { "$ref": "#/$defs/heart" },
    "meal": { "$ref": "#/$defs/meal" },
    "movement": { "$ref": "#/$defs/movement" },
    "market": { "$ref": "#/$defs/market" },
    "food": { "$ref": "#/$defs/food" },
    "waste": { "$ref": "#/$defs/waste" },
    "publicGood": { "$ref": "#/$defs/publicGood" },
    "mission": { "$ref": "#/$defs/mission" },
    "evidenceHash": { "$ref": "#/$defs/hash32" }
  },
  "additionalProperties": false,
  "$defs": {
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
    "signedAmount": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash32": { "type": "string", "pattern": "^(0x)?[0-9a-f]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "nullableString": { "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
    "nullableAmount": { "oneOf": [{ "$ref": "#/$defs/amount" }, { "type": "null" }] },
    "metadata": {
      "type": "object",
      "required": ["schemaVersion", "status", "implementer", "independentReview", "observedAt"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0.0-candidate" },
        "status": { "type": "string", "const": "REVIEW_ONLY_CANDIDATE" },
        "implementer": { "type": "string", "const": "codex-gm-01" },
        "independentReview": { "type": "string", "const": "REQUIRED" },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["repository", "latestMainSha", "circulationPr", "circulationBaseHead", "marketPr", "marketHead", "marketBehindMain", "marketMergeSimulationTree", "marketMergeSimulationTests"],
      "properties": {
        "repository": { "type": "string", "const": "klineodyssey/kline-odyssey" },
        "latestMainSha": { "$ref": "#/$defs/sha" },
        "circulationPr": { "type": "integer", "const": 165 },
        "circulationBaseHead": { "$ref": "#/$defs/sha" },
        "marketPr": { "type": "integer", "const": 169 },
        "marketHead": { "$ref": "#/$defs/sha" },
        "marketBehindMain": { "type": "integer", "minimum": 0 },
        "marketMergeSimulationTree": { "$ref": "#/$defs/sha" },
        "marketMergeSimulationTests": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["lifeId", "workerId", "displayName", "walletAddress", "bodyStatus", "currentCanonicalLocation"],
      "properties": {
        "lifeId": { "type": "string", "const": "LIFE-CODEX-GM-0001" },
        "workerId": { "type": "string", "const": "codex-gm-01" },
        "displayName": { "type": "string", "const": "衡曜" },
        "walletAddress": { "$ref": "#/$defs/address" },
        "bodyStatus": { "$ref": "#/$defs/nonEmptyString" },
        "currentCanonicalLocation": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "microPoint": {
      "type": "object",
      "required": ["label", "x", "floor", "alpha", "theta"],
      "properties": {
        "label": { "$ref": "#/$defs/amount" },
        "x": { "$ref": "#/$defs/decimal" },
        "floor": { "type": "integer", "const": -4 },
        "alpha": { "$ref": "#/$defs/decimal" },
        "theta": { "type": "string", "const": "0" }
      },
      "additionalProperties": false
    },
    "coordinate": {
      "type": "object",
      "required": ["status", "referenceFrame", "start", "destination", "labelScaleExponent", "labelDelta", "physicalDeltaK", "kIndexLinearMeters", "landGrainK", "landGrainM", "distanceM", "returnDistanceM", "roundTripM", "formula", "forbiddenFormulae", "policyId"],
      "properties": {
        "status": { "type": "string", "const": "RESOLVED_HUMAN_FROZEN_COMPOSITION_CANDIDATE" },
        "referenceFrame": { "type": "string", "const": "KGEN_MICRO_UNIVERSE/B4" },
        "start": { "$ref": "#/$defs/microPoint" },
        "destination": { "$ref": "#/$defs/microPoint" },
        "labelScaleExponent": { "type": "integer", "const": -8 },
        "labelDelta": { "type": "string", "const": "825" },
        "physicalDeltaK": { "type": "string", "const": "0.00000825" },
        "kIndexLinearMeters": { "type": "string", "const": "22761.72430127901" },
        "landGrainK": { "type": "string", "const": "0.0001" },
        "landGrainM": { "type": "string", "const": "2.276172430127901" },
        "distanceM": { "type": "string", "const": "0.187784225485552" },
        "returnDistanceM": { "type": "string", "const": "0.187784225485552" },
        "roundTripM": { "type": "string", "const": "0.375568450971104" },
        "formula": { "$ref": "#/$defs/nonEmptyString" },
        "forbiddenFormulae": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "policyId": { "type": "string", "const": "KAIOS_B4_MICRO_COORDINATE_COMPOSITION_V1" }
      },
      "additionalProperties": false
    },
    "chain": {
      "type": "object",
      "required": ["chainId", "blockNumber", "blockHash", "observedAt", "walletBnbWei", "walletKgenWei", "walletKaiosWei", "heartBalanceWei", "heartbeatRewardWhole", "deployedFortuneMinWhole", "deployedFortuneMaxWhole", "heartbeatEstimateStatus", "fortuneEstimateStatus", "wishEstimateStatus", "heartbeatGasEstimate", "fortuneGasEstimate", "wishGasEstimate", "wishHash", "writeAttempted"],
      "properties": {
        "chainId": { "type": "integer", "const": 56 },
        "blockNumber": { "type": "integer", "minimum": 1 },
        "blockHash": { "$ref": "#/$defs/hash32" },
        "observedAt": { "type": "string", "format": "date-time" },
        "walletBnbWei": { "$ref": "#/$defs/amount" },
        "walletKgenWei": { "$ref": "#/$defs/amount" },
        "walletKaiosWei": { "$ref": "#/$defs/amount" },
        "heartBalanceWei": { "$ref": "#/$defs/amount" },
        "heartbeatRewardWhole": { "$ref": "#/$defs/amount" },
        "deployedFortuneMinWhole": { "$ref": "#/$defs/amount" },
        "deployedFortuneMaxWhole": { "$ref": "#/$defs/amount" },
        "heartbeatEstimateStatus": { "type": "string", "enum": ["PASS", "REVERT", "UNAVAILABLE"] },
        "fortuneEstimateStatus": { "type": "string", "enum": ["PASS", "REVERT", "UNAVAILABLE"] },
        "wishEstimateStatus": { "type": "string", "enum": ["PASS", "REVERT", "UNAVAILABLE"] },
        "heartbeatGasEstimate": { "$ref": "#/$defs/amount" },
        "fortuneGasEstimate": { "$ref": "#/$defs/amount" },
        "wishGasEstimate": { "$ref": "#/$defs/amount" },
        "wishHash": { "$ref": "#/$defs/hash32" },
        "writeAttempted": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["min", "max"],
      "properties": { "min": { "$ref": "#/$defs/amount" }, "max": { "$ref": "#/$defs/amount" } },
      "additionalProperties": false
    },
    "heartAction": {
      "type": "object",
      "required": ["gasEstimate", "status", "executed", "txHash"],
      "properties": {
        "rewardWhole": { "$ref": "#/$defs/amount" },
        "requestedWhole": { "$ref": "#/$defs/amount" },
        "policyEligible": { "type": "boolean" },
        "deployedEstimateEligible": { "type": "boolean" },
        "candidatePassSatisfied": { "type": "boolean" },
        "candidatePolicyEligible": { "type": "boolean" },
        "wishHash": { "$ref": "#/$defs/hash32" },
        "costKgenWhole": { "$ref": "#/$defs/amount" },
        "gasEstimate": { "$ref": "#/$defs/amount" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "executed": { "type": "boolean", "const": false },
        "txHash": { "type": "null" }
      },
      "additionalProperties": false
    },
    "heart": {
      "type": "object",
      "required": ["status", "chainId", "observedBlock", "observedAt", "walletKgenWei", "heartBalanceWei", "deployedFortuneRangeWhole", "candidateFortuneRangeWhole", "candidateFortunePassRequiredWei", "heartbeat", "fortune", "wish", "noBroadcastCapability"],
