        "status": { "$ref": "#/$defs/nonEmptyString" },
        "inputKgenWhole": { "$ref": "#/$defs/amount" },
        "wishReceiptConfirmed": { "type": "boolean" },
        "rateBps": { "type": "integer", "enum": [5000, 8000] },
        "ratePercent": { "type": "string", "enum": ["50", "80"] },
        "calculatedKaiosWhole": { "$ref": "#/$defs/amount" },
        "actualKaiosWhole": { "$ref": "#/$defs/amount" },
        "settlementRuntimeStatus": { "$ref": "#/$defs/nonEmptyString" },
        "settlementReceipt": { "type": "null" },
        "mintsKaios": { "type": "boolean", "const": false },
        "metabolismPolicyStatus": { "$ref": "#/$defs/nonEmptyString" },
        "consumedKaiosWhole": { "$ref": "#/$defs/nullableAmount" },
        "mealPaymentTx": { "type": "null" }
      },
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "required": ["bodyId", "bodyType", "realWorldHumanoid", "status"],
      "properties": {
        "bodyId": { "$ref": "#/$defs/nonEmptyString" },
        "bodyType": { "type": "string", "const": "DIGITAL_FOLDER_BODY_CANDIDATE" },
        "realWorldHumanoid": { "type": "boolean", "const": false },
        "status": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "physics": {
      "type": "object",
      "required": ["status", "distanceM", "missingInputs", "totalMassKg", "forceN", "accelerationWorkJ", "totalEnergyJ", "travelTimeSeconds", "outboundFuelKgenWei", "returnFuelKgenWei", "energyModelEvidenceId", "usesMassEnergyConversion"],
      "properties": {
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "distanceM": { "$ref": "#/$defs/decimal" },
        "missingInputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "totalMassKg": { "$ref": "#/$defs/nullableString" },
        "forceN": { "$ref": "#/$defs/nullableString" },
        "accelerationWorkJ": { "$ref": "#/$defs/nullableString" },
        "totalEnergyJ": { "$ref": "#/$defs/nullableString" },
        "travelTimeSeconds": { "$ref": "#/$defs/nullableString" },
        "outboundFuelKgenWei": { "$ref": "#/$defs/nullableAmount" },
        "returnFuelKgenWei": { "$ref": "#/$defs/nullableAmount" },
        "energyModelEvidenceId": { "$ref": "#/$defs/nullableString" },
        "usesMassEnergyConversion": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "fare": {
      "type": "object",
      "required": ["status", "fareKgenWei", "missingEvidence"],
      "properties": {
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "components": {
          "type": "object",
          "required": ["energyCostKgenWei", "laborCostKgenWei", "vehicleDepreciationKgenWei", "maintenanceKgenWei", "riskReserveKgenWei", "profitKgenWei"],
          "properties": {
            "energyCostKgenWei": { "$ref": "#/$defs/amount" },
            "laborCostKgenWei": { "$ref": "#/$defs/amount" },
            "vehicleDepreciationKgenWei": { "$ref": "#/$defs/amount" },
            "maintenanceKgenWei": { "$ref": "#/$defs/amount" },
            "riskReserveKgenWei": { "$ref": "#/$defs/amount" },
            "profitKgenWei": { "$ref": "#/$defs/amount" }
          },
          "additionalProperties": false
        },
        "fareKgenWei": { "$ref": "#/$defs/nullableAmount" },
        "missingEvidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "additionalProperties": false
    },
    "movement": {
      "type": "object",
      "required": ["status", "movementEngine", "realWorldHumanoidClaimed", "currentCanonicalLocation", "plannedOriginX", "plannedDestinationX", "distanceM", "body", "physics", "outboundFare", "returnFare", "emergencyReserveKgenWei", "requiredFundsKgenWei", "movementEvidenceComplete", "arrived11520", "positionMutationCommitted"],
      "properties": {
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "movementEngine": { "type": "string", "const": "DIGITAL_BODY_PLUS_KGEN_MASS_CANDIDATE" },
        "realWorldHumanoidClaimed": { "type": "boolean", "const": false },
        "currentCanonicalLocation": { "$ref": "#/$defs/nonEmptyString" },
        "plannedOriginX": { "type": "string", "const": "0.00012345" },
        "plannedDestinationX": { "type": "string", "const": "0.00011520" },
        "distanceM": { "type": "string", "const": "0.187784225485552" },
        "body": { "$ref": "#/$defs/body" },
        "physics": { "$ref": "#/$defs/physics" },
        "outboundFare": { "$ref": "#/$defs/fare" },
        "returnFare": { "$ref": "#/$defs/fare" },
        "emergencyReserveKgenWei": { "$ref": "#/$defs/amount" },
        "requiredFundsKgenWei": { "$ref": "#/$defs/nullableAmount" },
        "movementEvidenceComplete": { "type": "boolean" },
        "arrived11520": { "type": "boolean" },
        "positionMutationCommitted": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "required": ["status", "implementation", "marketCellCoordinate", "bestBuy", "bestSell", "ct", "tradeCount", "quoteAsset", "quoteStatus", "action", "fruitQuantityKgen", "fruitTradePrice", "settlement", "txHash"],
      "properties": {
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "implementation": { "type": "string", "const": "PR169_EXACT_HEAD_INTERFACE" },
        "marketCellCoordinate": { "type": "string", "const": "0.00011520" },
        "bestBuy": { "$ref": "#/$defs/nullableString" },
        "bestSell": { "$ref": "#/$defs/nullableString" },
        "ct": { "$ref": "#/$defs/nullableString" },
        "tradeCount": { "type": "integer", "minimum": 0 },
        "quoteAsset": { "$ref": "#/$defs/nonEmptyString" },
        "quoteStatus": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/nonEmptyString" },
        "fruitQuantityKgen": { "$ref": "#/$defs/nullableString" },
        "fruitTradePrice": { "$ref": "#/$defs/nullableString" },
        "settlement": { "$ref": "#/$defs/nonEmptyString" },
        "txHash": { "type": "null" }
      },
      "additionalProperties": false
    },
    "food": {
      "type": "object",
      "required": ["status", "unit", "input", "metabolized", "stored", "waste", "evidenceId"],
      "properties": {
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "input": { "$ref": "#/$defs/amount" },
        "metabolized": { "$ref": "#/$defs/amount" },
        "stored": { "$ref": "#/$defs/amount" },
        "waste": { "$ref": "#/$defs/amount" },
        "evidenceId": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "waste": {
      "type": "object",
      "required": ["status", "massUnit", "inputWasteMass", "recycledOutputMass", "residualWasteMass", "processingLossMass", "costKgenWei", "revenueKgenWei", "netProfitKgenWei", "evidenceId"],
      "properties": {
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "massUnit": { "$ref": "#/$defs/nonEmptyString" },
        "inputWasteMass": { "$ref": "#/$defs/amount" },
        "recycledOutputMass": { "$ref": "#/$defs/amount" },
        "residualWasteMass": { "$ref": "#/$defs/amount" },
        "processingLossMass": { "$ref": "#/$defs/amount" },
        "costKgenWei": { "$ref": "#/$defs/amount" },
        "revenueKgenWei": { "$ref": "#/$defs/amount" },
        "netProfitKgenWei": { "$ref": "#/$defs/signedAmount" },
        "evidenceId": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "purposeLedger": {
      "type": "object",
      "required": ["purpose", "asset", "calculatedAmountRaw", "actualAmountRaw", "chainId", "from", "to", "status", "txHash", "blockNumber", "blockHash", "receiptStatus", "confirmationCount", "finalityStatus", "canonicalBlockVerified", "assetContract", "providerId", "evidenceId"],
      "properties": {
        "purpose": { "type": "string", "enum": ["MEAL", "MICRO_UNIVERSE_TRANSPORT", "FRUIT", "DONATION"] },
        "asset": { "type": "string", "enum": ["KGEN", "KAIOS", "NATIVE_BNB"] },
        "calculatedAmountRaw": { "$ref": "#/$defs/amount" },
        "actualAmountRaw": { "$ref": "#/$defs/amount" },
        "chainId": { "type": "integer", "const": 56 },
        "from": { "$ref": "#/$defs/address" },
        "to": { "type": "string", "const": "0xB73D6716005B37BEC742D64482fA26033eE1A4E1" },
        "status": { "type": "string", "enum": ["CALCULATED_NOT_SENT", "CONFIRMED"] },
        "txHash": { "oneOf": [{ "$ref": "#/$defs/hash32" }, { "type": "null" }] },
        "blockNumber": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "blockHash": { "oneOf": [{ "$ref": "#/$defs/hash32" }, { "type": "null" }] },
        "receiptStatus": { "oneOf": [{ "type": "integer", "const": 1 }, { "type": "null" }] },
        "confirmationCount": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "finalityStatus": { "oneOf": [{ "type": "string", "const": "CANONICAL_BLOCK_AND_MINIMUM_CONFIRMATIONS_VERIFIED" }, { "type": "null" }] },
        "canonicalBlockVerified": { "type": "boolean" },
        "assetContract": { "oneOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
        "providerId": { "$ref": "#/$defs/nullableString" },
        "evidenceId": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "publicGoodTotals": {
      "type": "object",
      "required": ["KAIOS", "KGEN", "NATIVE_BNB"],
      "properties": { "KAIOS": { "$ref": "#/$defs/amount" }, "KGEN": { "$ref": "#/$defs/amount" }, "NATIVE_BNB": { "$ref": "#/$defs/amount" } },
      "additionalProperties": false
    },
    "publicGood": {
      "type": "object",
      "required": ["status", "treasury", "purposeLedgers", "actualTotalsRaw"],
      "properties": {
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "treasury": { "type": "string", "const": "0xB73D6716005B37BEC742D64482fA26033eE1A4E1" },
        "purposeLedgers": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/purposeLedger" } },
        "actualTotalsRaw": { "$ref": "#/$defs/publicGoodTotals" }
      },
      "additionalProperties": false
    },
    "mission": {
      "type": "object",
      "required": ["status", "arrived11520", "returnStatus", "endLocation", "gmClockIn", "nextCompanyWork", "hardBlockers", "autoResolvedBlockers", "noFakeMovement", "noFakeTrade", "noFakePayment"],
      "properties": {
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "arrived11520": { "type": "boolean" },
        "returnStatus": { "$ref": "#/$defs/nonEmptyString" },
        "endLocation": { "$ref": "#/$defs/nonEmptyString" },
        "gmClockIn": { "type": "boolean" },
        "nextCompanyWork": { "$ref": "#/$defs/nullableString" },
        "hardBlockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["AUTHORIZED_SECURE_TRANSACTION_PATH_REQUIRED", "IRREVERSIBLE_MAINNET_AUTHORITY_MISSING", "REAL_ASSET_INSUFFICIENT", "HUMAN_GOVERNANCE_REQUIRED", "CANON_UNRESOLVABLE"] } },
        "autoResolvedBlockers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "noFakeMovement": { "type": "boolean", "const": true },
        "noFakeTrade": { "type": "boolean", "const": true },
        "noFakePayment": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    }
