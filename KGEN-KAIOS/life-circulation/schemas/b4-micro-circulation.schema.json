        "status": { "$ref": "#/$defs/nonEmptyString" },
        "chainId": { "type": "integer", "const": 56 },
        "observedBlock": { "type": "integer", "minimum": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "walletKgenWei": { "$ref": "#/$defs/amount" },
        "heartBalanceWei": { "$ref": "#/$defs/amount" },
        "deployedFortuneRangeWhole": { "$ref": "#/$defs/range" },
        "candidateFortuneRangeWhole": { "$ref": "#/$defs/range" },
        "candidateFortunePassRequiredWei": { "$ref": "#/$defs/amount" },
        "heartbeat": { "$ref": "#/$defs/heartAction" },
        "fortune": { "$ref": "#/$defs/heartAction" },
        "wish": { "$ref": "#/$defs/heartAction" },
        "noBroadcastCapability": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "meal": {
      "type": "object",
      "required": ["status", "inputKgenWhole", "wishReceiptConfirmed", "rateBps", "ratePercent", "calculatedKaiosWhole", "actualKaiosWhole", "settlementRuntimeStatus", "settlementReceipt", "mintsKaios", "metabolismPolicyStatus", "consumedKaiosWhole", "mealPaymentTx"],
