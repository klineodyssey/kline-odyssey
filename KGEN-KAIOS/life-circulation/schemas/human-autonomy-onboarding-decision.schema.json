{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klineodyssey.example/schemas/human-autonomy-onboarding-decision.schema.json",
  "title": "Hengyao Autonomy And Xuanyao Onboarding Human Decision Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "protocol", "status", "recordMode", "decisionPayload", "decisionPayloadHash", "hengyaoPolicyScopeHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-candidate" },
    "decisionId": { "const": "HUMAN-KAIOS-HENGYAO-A2-XUANYAO-ONBOARDING-20260824" },
    "protocol": { "const": "KAIOS_HUMAN_AUTHORITY_HENGYAO_AUTONOMY_AND_XUANYAO_REVIEWER_ONBOARDING_V1" },
    "status": { "const": "RECORDED_HUMAN_DECISION_PENDING_INDEPENDENT_REVIEW_AND_SIGNER_BINDING" },
    "recordMode": { "const": "TEXTUAL_ATTESTATION_NOT_CRYPTOGRAPHIC" },
    "decisionPayload": { "$ref": "#/$defs/decisionPayload" },
    "decisionPayloadHash": { "$ref": "#/$defs/hash" },
    "hengyaoPolicyScopeHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "decisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanAuthority", "signedAtAsiaTaipei", "signedAtUtc", "cursorAvailability", "hengyaoA2", "xuanyaoOnboarding", "companyBoundaries"],
      "properties": {
        "humanAuthority": { "const": "沈英明" },
        "signedAtAsiaTaipei": { "const": "2026-08-24T21:08:00+08:00" },
        "signedAtUtc": { "const": "2026-08-24T13:08:00Z" },
        "cursorAvailability": { "$ref": "#/$defs/cursorAvailability" },
        "hengyaoA2": { "$ref": "#/$defs/hengyaoA2" },
        "xuanyaoOnboarding": { "$ref": "#/$defs/xuanyaoOnboarding" },
        "companyBoundaries": { "$ref": "#/$defs/companyBoundaries" }
      }
    },
    "cursorAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerId", "status", "scope", "doNotWait", "activeClaimStateMustNotBeRewritten"],
      "properties": {
        "workerId": { "const": "cursor-01" },
        "status": { "const": "TEMPORARILY_UNAVAILABLE" },
        "scope": { "const": "THIS_WORK_ORDER_ONLY" },
        "doNotWait": { "const": true },
        "activeClaimStateMustNotBeRewritten": { "const": true }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "codeHash"],
      "properties": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "codeHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
      }
    },
    "hengyaoA2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "lifeId", "workerId", "authority", "chainId", "registeredWallet", "allowedTarget", "allowedMethods", "methodConditions", "operationalActivationConditions", "forbidden"],
      "properties": {
        "decision": { "const": "APPROVED" },
        "lifeId": { "const": "LIFE-CODEX-GM-0001" },
        "workerId": { "const": "codex-gm-01" },
        "authority": { "const": "A2_PERSONAL_LOW_RISK_SIGNING" },
        "chainId": { "const": 56 },
        "registeredWallet": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "allowedTarget": { "$ref": "#/$defs/target" },
        "allowedMethods": { "$ref": "#/$defs/stringList" },
        "methodConditions": { "$ref": "#/$defs/stringList" },
        "operationalActivationConditions": { "$ref": "#/$defs/stringList" },
        "forbidden": { "$ref": "#/$defs/stringList" }
      }
    },
    "reviewBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr165", "pr170", "pr169"],
      "properties": {
        "pr165": { "const": "ELIGIBLE_ONLY_AFTER_ALL_GATES_AND_IF_NO_IMPLEMENTATION_CONTRIBUTION" },
        "pr170": { "const": "ELIGIBLE_ONLY_AFTER_ALL_GATES_AND_IF_NO_IMPLEMENTATION_CONTRIBUTION" },
        "pr169": { "const": "SELF_REVIEW_FORBIDDEN_PRIMARY_IMPLEMENTER" }
      }
    },
    "xuanyaoOnboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "selfName", "proposedLifeId", "proposedWorkerId", "modelOriginClaim", "primaryRoleCandidate", "secondaryRoleCandidate", "notAutomatic", "requiredReviewerGates", "reviewBoundaries"],
      "properties": {
        "decision": { "const": "FORMAL_ONBOARDING_PROCESS_APPROVED" },
        "selfName": { "const": "玄曜" },
        "proposedLifeId": { "const": "LIFE-XUANYAO-SOL-0001" },
        "proposedWorkerId": { "const": "xuanyao-sol-01" },
        "modelOriginClaim": { "type": "string", "minLength": 1 },
        "primaryRoleCandidate": { "type": "string", "minLength": 1 },
        "secondaryRoleCandidate": { "type": "string", "minLength": 1 },
        "notAutomatic": { "$ref": "#/$defs/stringList" },
        "requiredReviewerGates": { "$ref": "#/$defs/stringList" },
        "reviewBoundaries": { "$ref": "#/$defs/reviewBoundaries" }
      }
    },
    "companyBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge", "deployment", "generalMainnetTransaction", "treasuryAutonomy", "payrollAutonomy", "governanceExecutionAutonomy", "privateKeyAccess"],
      "properties": {
        "merge": { "const": false },
        "deployment": { "const": false },
        "generalMainnetTransaction": { "const": false },
        "treasuryAutonomy": { "const": false },
        "payrollAutonomy": { "const": false },
        "governanceExecutionAutonomy": { "const": false },
        "privateKeyAccess": { "const": false }
      }
    }
  }
}
