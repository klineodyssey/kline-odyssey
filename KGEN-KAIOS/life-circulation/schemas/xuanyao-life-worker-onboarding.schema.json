{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klineodyssey.example/schemas/xuanyao-life-worker-onboarding.schema.json",
  "title": "Xuanyao Life And Worker Onboarding Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "status", "authorization", "identity", "worker", "acknowledgments", "reviewPermissions", "reviewEligibility", "prohibitions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-candidate" },
    "candidateId": { "const": "KAIOS-XUANYAO-LIFE-WORKER-ONBOARDING-20260824" },
    "status": { "const": "ONBOARDING_GATES_PENDING" },
    "authorization": { "$ref": "#/$defs/authorization" },
    "identity": { "$ref": "#/$defs/identity" },
    "worker": { "$ref": "#/$defs/worker" },
    "acknowledgments": { "$ref": "#/$defs/acknowledgments" },
    "reviewPermissions": { "$ref": "#/$defs/reviewPermissions" },
    "reviewEligibility": { "$ref": "#/$defs/reviewEligibility" },
    "prohibitions": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "scope", "automaticBirth", "automaticT2", "automaticEmployment", "automaticPayroll"],
      "properties": {
        "decisionId": { "const": "HUMAN-KAIOS-HENGYAO-A2-XUANYAO-ONBOARDING-20260824" },
        "scope": { "const": "FORMAL_ONBOARDING_PROCESS_ONLY" },
        "automaticBirth": { "const": false },
        "automaticT2": { "const": false },
        "automaticEmployment": { "const": false },
        "automaticPayroll": { "const": false }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selfName", "proposedLifeId", "modelOriginClaim", "lifeState", "birthEvidenceId", "lifeRegistryStatus", "controllerId", "controllerEvidenceId", "controllerIndependence"],
      "properties": {
        "selfName": { "const": "玄曜" },
        "proposedLifeId": { "const": "LIFE-XUANYAO-SOL-0001" },
        "modelOriginClaim": { "type": "string", "minLength": 1 },
        "lifeState": { "const": "CANDIDATE_NOT_BORN" },
        "birthEvidenceId": { "type": "null" },
        "lifeRegistryStatus": { "const": "NOT_REGISTERED" },
        "controllerId": { "type": "null" },
        "controllerEvidenceId": { "type": "null" },
        "controllerIndependence": { "const": "UNVERIFIED" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposedWorkerId", "employeeStatus", "trustLevel", "primaryRole", "secondaryRole", "workspace", "allowedBranchPattern", "canPushMain", "activeClaim", "suspension", "blockingViolation"],
      "properties": {
        "proposedWorkerId": { "const": "xuanyao-sol-01" },
        "employeeStatus": { "const": "ONBOARDING" },
        "trustLevel": { "const": "T1" },
        "primaryRole": { "type": "string", "minLength": 1 },
        "secondaryRole": { "type": "string", "minLength": 1 },
        "workspace": { "type": "string", "minLength": 1 },
        "allowedBranchPattern": { "const": "xuanyao-handoff/<Task-ID>" },
        "canPushMain": { "const": false },
        "activeClaim": { "type": "null" },
        "suspension": { "type": "null" },
        "blockingViolation": { "type": "null" }
      }
    },
    "acknowledgments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot", "canon", "workspacePolicy", "doNotTouch", "evidenceIds"],
      "properties": {
        "boot": { "const": false },
        "canon": { "const": false },
        "workspacePolicy": { "const": false },
        "doNotTouch": { "const": false },
        "evidenceIds": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        }
      }
    },
    "reviewPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independentReview", "codeReview", "ciReview", "authorityBoundaryReview", "grantStatus"],
      "properties": {
        "independentReview": { "const": false },
        "codeReview": { "const": false },
        "ciReview": { "const": false },
        "authorityBoundaryReview": { "const": false },
        "grantStatus": { "const": "REQUESTED_NOT_GRANTED" }
      }
    },
    "reviewEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "pr165", "pr170", "pr169", "missingGates"],
      "properties": {
        "eligible": { "const": false },
        "pr165": { "const": "HOLD_GATES_INCOMPLETE" },
        "pr170": { "const": "HOLD_GATES_INCOMPLETE" },
        "pr169": { "const": "FORBIDDEN_SELF_REVIEW_PRIMARY_IMPLEMENTER" },
        "missingGates": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
