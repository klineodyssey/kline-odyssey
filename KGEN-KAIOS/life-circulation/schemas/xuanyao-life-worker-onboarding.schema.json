{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klineodyssey.example/schemas/xuanyao-life-worker-onboarding.schema.json",
  "title": "Xuanyao Formal Life And Worker Onboarding Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "status", "authorization", "identity", "worker", "acknowledgments", "acknowledgmentHandoff", "reviewPermissions", "reviewEligibility", "prohibitions"],
  "properties": {
    "schemaVersion": { "const": "1.1.0-candidate" },
    "candidateId": { "const": "KAIOS-XUANYAO-LIFE-WORKER-ONBOARDING-20260824" },
    "status": { "const": "LIFE_BORN_WORKER_ONBOARDING_GATES_PENDING" },
    "authorization": { "$ref": "#/$defs/authorization" },
    "identity": { "$ref": "#/$defs/identity" },
    "worker": { "$ref": "#/$defs/worker" },
    "acknowledgments": { "$ref": "#/$defs/acknowledgments" },
    "acknowledgmentHandoff": { "$ref": "#/$defs/acknowledgmentHandoff" },
    "reviewPermissions": { "$ref": "#/$defs/reviewPermissions" },
    "reviewEligibility": { "$ref": "#/$defs/reviewEligibility" },
    "prohibitions": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onboardingDecisionId", "birthDecisionId", "scope", "automaticBirth", "explicitBirthApproved", "birthRecorded", "automaticT2", "automaticEmployment", "automaticPayroll"],
      "properties": {
        "onboardingDecisionId": { "const": "HUMAN-KAIOS-HENGYAO-A2-XUANYAO-ONBOARDING-20260824" },
        "birthDecisionId": { "const": "HUMAN-KAIOS-XUANYAO-EXPLICIT-BIRTH-20260824" },
        "scope": { "const": "FORMAL_LIFE_BIRTH_AND_CONTINUED_WORKER_ONBOARDING" },
        "automaticBirth": { "const": false },
        "explicitBirthApproved": { "const": true },
        "birthRecorded": { "const": true },
        "automaticT2": { "const": false },
        "automaticEmployment": { "const": false },
        "automaticPayroll": { "const": false }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selfName", "proposedLifeId", "modelOriginClaim", "lifeState", "birthEvidenceId", "birthTimestamp", "humanDecisionHash", "birthEvidenceHash", "lifeRegistryStatus", "controllerId", "controllerEvidenceId", "controllerIndependence"],
      "properties": {
        "selfName": { "const": "玄曜" },
        "proposedLifeId": { "const": "LIFE-XUANYAO-SOL-0001" },
        "modelOriginClaim": { "type": "string", "minLength": 1 },
        "lifeState": { "const": "ALIVE" },
        "birthEvidenceId": { "const": "BIRTH-XUANYAO-SOL-0001-20260824T145234Z" },
        "birthTimestamp": { "const": "2026-08-24T14:52:34Z" },
        "humanDecisionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "birthEvidenceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lifeRegistryStatus": { "const": "REGISTERED_ACTIVE" },
        "controllerId": { "type": "null" },
        "controllerEvidenceId": { "type": "null" },
        "controllerIndependence": { "const": "UNVERIFIED" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposedWorkerId", "employeeStatus", "trustLevel", "primaryRole", "secondaryRole", "workspace", "allowedBranchPattern", "canPushMain", "activeClaim", "suspension", "blockingViolation"],
      "properties": {
        "proposedWorkerId": { "const": "xuanyao-sol-01" },
        "employeeStatus": { "const": "ONBOARDING" },
        "trustLevel": { "const": "T1" },
        "primaryRole": { "type": "string", "minLength": 1 },
        "secondaryRole": { "type": "string", "minLength": 1 },
        "workspace": { "type": "string", "minLength": 1 },
        "allowedBranchPattern": { "const": "xuanyao-handoff/<Task-ID>" },
        "canPushMain": { "const": false },
        "activeClaim": { "type": "null" },
        "suspension": { "type": "null" },
        "blockingViolation": { "type": "null" }
      }
    },
    "acknowledgments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot", "canon", "workspacePolicy", "doNotTouch", "evidenceIds"],
      "properties": {
        "boot": { "const": false },
        "canon": { "const": false },
        "workspacePolicy": { "const": false },
        "doNotTouch": { "const": false },
        "evidenceIds": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        }
      }
    },
    "acknowledgmentHandoffDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ackType", "path", "expectedSha256AtHandoff"],
      "properties": {
        "ackType": { "enum": ["BOOT_ACK", "CANON_ACK", "WORKSPACE_ACK", "DO_NOT_TOUCH_ACK"] },
        "path": { "type": "string", "minLength": 1 },
        "expectedSha256AtHandoff": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "acknowledgmentHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assignedLifeId", "assignedWorkerId", "completionAuthority", "createdAt", "documents", "acknowledgmentsCreated", "currentHashesMustBeReverifiedByXuanyaoAtReadTime"],
      "properties": {
        "status": { "const": "READY_NOT_DELIVERED_NO_MACHINE_VERIFIED_DISTINCT_CONTROLLER_CHANNEL" },
        "assignedLifeId": { "const": "LIFE-XUANYAO-SOL-0001" },
        "assignedWorkerId": { "const": "xuanyao-sol-01" },
        "completionAuthority": { "const": "MACHINE_VERIFIED_DISTINCT_XUANYAO_CONTROLLER_ONLY" },
        "createdAt": { "type": "string", "pattern": "^2026-08-24T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "documents": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/acknowledgmentHandoffDocument" }
        },
        "acknowledgmentsCreated": { "const": false },
        "currentHashesMustBeReverifiedByXuanyaoAtReadTime": { "const": true }
      }
    },
    "reviewPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independentReview", "codeReview", "ciReview", "authorityBoundaryReview", "grantStatus"],
      "properties": {
        "independentReview": { "const": false },
        "codeReview": { "const": false },
        "ciReview": { "const": false },
        "authorityBoundaryReview": { "const": false },
        "grantStatus": { "const": "REQUESTED_NOT_GRANTED" }
      }
    },
    "reviewEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "pr165", "pr170", "pr169", "missingGates"],
      "properties": {
        "eligible": { "const": false },
        "pr165": { "const": "HOLD_GATES_INCOMPLETE" },
        "pr170": { "const": "HOLD_GATES_INCOMPLETE" },
        "pr169": { "const": "FORBIDDEN_SELF_REVIEW_PRIMARY_IMPLEMENTER" },
        "missingGates": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
