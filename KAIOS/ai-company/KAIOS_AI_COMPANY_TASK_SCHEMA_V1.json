{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klineodyssey.github.io/kline-odyssey/KAIOS/ai-company/KAIOS_AI_COMPANY_TASK_SCHEMA_V1.json",
  "title": "KAIOS AI Company Task V1",
  "type": "object",
  "required": ["task_id", "work_package_id", "objective", "location", "start_condition", "end_condition", "duration_hours", "remaining_hours", "workers", "skills", "materials", "equipment", "energy", "transport", "cost", "predecessors", "successors", "quality_gate", "safety_gate", "status", "progress_percent", "consumed"],
  "properties": {
    "task_id": { "type": "string" }, "work_package_id": { "type": "string" }, "objective": { "type": "string" }, "location": { "type": ["string", "null"] },
    "start_condition": { "type": "array", "items": { "type": "string" } }, "end_condition": { "type": "array", "items": { "type": "string" } },
    "duration_hours": { "type": "number", "exclusiveMinimum": 0 }, "remaining_hours": { "type": "number", "minimum": 0 },
    "workers": { "type": "array", "items": { "type": "string" } }, "skills": { "type": "array", "items": { "type": "string" } },
    "materials": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
    "equipment": { "type": "array", "items": { "type": "string" } }, "energy": { "type": "number", "minimum": 0 },
    "transport": { "type": "array", "items": { "type": "string" } }, "cost": { "type": "number", "minimum": 0 },
    "predecessors": { "type": "array", "items": { "type": "string" } }, "successors": { "type": "array", "items": { "type": "string" } },
    "quality_gate": { "type": "string" }, "safety_gate": { "type": "string" },
    "status": { "enum": ["NOT_READY", "READY", "IN_PROGRESS", "PAUSED", "BLOCKED", "FAILED", "REWORK_REQUIRED", "INSPECTION_PENDING", "APPROVED", "COMPLETE", "CANCELLED"] },
    "progress_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "consumed": { "type": "object", "required": ["labor_hours", "energy", "materials", "equipment_wear", "cost"], "properties": { "labor_hours": { "type": "number", "minimum": 0 }, "energy": { "type": "number", "minimum": 0 }, "materials": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }, "equipment_wear": { "type": "number", "minimum": 0 }, "cost": { "type": "number", "minimum": 0 } }, "additionalProperties": false }
  },
  "additionalProperties": false,
  "x-kaios-invariants": ["duration_hours > 0", "status IN_PROGRESS requires all mandatory predecessors complete", "progress consumes time and finite resources", "one physical life cannot hold overlapping physical assignments"]
}
