{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klineodyssey.github.io/kline-odyssey/KAIOS/life/ecology/KAIOS_REPRODUCTION_ECOLOGY_SCHEMA_V1.json",
  "title": "KAIOS Reproduction and Ecology Runtime V1 State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "mode", "seed", "simulation_time", "status", "entities", "habitats", "populations", "resources", "exported_population_count", "conditions", "candidate_lineages", "events", "action_log", "revision", "boundaries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "runtime": { "const": "KAIOS_REPRODUCTION_ECOLOGY_RUNTIME_V1" },
    "mode": { "const": "LOCAL_DETERMINISTIC_SIMULATION" },
    "seed": { "type": "string", "minLength": 1, "maxLength": 128 },
    "simulation_time": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "status": { "enum": ["PAUSED", "RUNNING", "STOPPED"] },
    "entities": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/entity" } },
    "habitats": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/habitat" } },
    "populations": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/population" } },
    "resources": { "$ref": "#/$defs/resources" },
    "exported_population_count": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "conditions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "candidate_lineages": { "type": "array", "maxItems": 500, "items": { "type": "object" } },
    "events": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/event" } },
    "action_log": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/action" } },
    "revision": { "type": "integer", "minimum": 0 },
    "integrity": { "type": "object" },
    "boundaries": { "$ref": "#/$defs/boundaries" }
  },
  "$defs": {
    "entityType": { "enum": ["ECOSYSTEM", "HABITAT", "POPULATION", "SPECIES_POPULATION", "FOOD_RELATION", "RESOURCE_POOL", "WATER_POOL", "SOIL_POOL", "NUTRIENT_POOL", "DECOMPOSITION_POOL", "CARRYING_CAPACITY", "REPRODUCTION_EVENT", "BIRTH_EVENT", "DEATH_EVENT", "MIGRATION_EVENT", "PREDATION_EVENT", "COMPETITION_EVENT", "DISEASE_EVENT", "POLLUTION_EVENT", "RESTORATION_EVENT", "SEASON_EVENT"] },
    "entity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "location", "simulation_time", "status", "source", "authority", "simulation_only", "history", "previous_state_hash", "next_state_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/entityType" },
        "location": { "type": "string" },
        "simulation_time": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "authority": { "const": "SIMULATION_ONLY" },
        "simulation_only": { "const": true },
        "history": { "type": "array", "maxItems": 1000 },
        "previous_state_hash": { "type": "string" },
        "next_state_hash": { "type": "string" }
      }
    },
    "habitatType": { "enum": ["GRASSLAND", "FOREST", "FISHPOND", "RIVER_HABITAT", "WETLAND", "SOIL_HABITAT", "MOUNTAIN_WATERSHED"] },
    "populationStatus": { "enum": ["STABLE", "GROWING", "DECLINING", "OVER_CAPACITY", "RESOURCE_STRESSED", "DISEASE_STRESSED", "POLLUTION_STRESSED", "COLLAPSING", "EXTINCT_LOCAL", "RECOVERING"] },
    "reproductionMode": { "enum": ["SEED_PROPAGATION", "VEGETATIVE_PROPAGATION", "SEXUAL_REPRODUCTION", "SPAWNING", "LARVAL_DEVELOPMENT", "NATURAL_FORMATION_CHANGE", "NO_REPRODUCTION"] },
    "habitat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "location", "simulation_time", "status", "source", "authority", "simulation_only", "history", "previous_state_hash", "next_state_hash", "area_m2", "water_l", "temperature_c", "oxygen_mg_l", "salinity_ppt", "soil_fertility", "pollution", "shelter", "season", "restoration_state", "flow_status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/habitatType" },
        "location": { "type": "string", "minLength": 1 },
        "simulation_time": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "authority": { "const": "SIMULATION_ONLY" },
        "simulation_only": { "const": true },
        "history": { "type": "array", "maxItems": 1000 },
        "previous_state_hash": { "type": "string" },
        "next_state_hash": { "type": "string" },
        "area_m2": { "type": "number", "exclusiveMinimum": 0 },
        "water_l": { "type": "number", "minimum": 0 },
        "temperature_c": { "type": "number", "minimum": -80, "maximum": 80 },
        "soil_fertility": { "type": "number", "minimum": 0, "maximum": 1 },
        "oxygen_mg_l": { "type": "number", "minimum": 0, "maximum": 30 },
        "salinity_ppt": { "type": "number", "minimum": 0, "maximum": 60 },
        "pollution": { "type": "number", "minimum": 0, "maximum": 1 },
        "shelter": { "type": "number", "minimum": 0, "maximum": 1 },
        "season": { "enum": ["SPRING", "SUMMER", "AUTUMN", "WINTER"] },
        "restoration_state": { "enum": ["NONE", "PLANNED", "ACTIVE", "RECOVERING", "RESTORED"] },
        "flow_status": { "enum": ["FLOWING_DOWNHILL", "NOT_APPLICABLE", "RIVER_FLOW_BLOCKED"] }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population_id", "species_id", "habitat_id", "count", "age_distribution", "sex_distribution", "health_distribution", "energy_reserve", "food_requirement", "water_requirement", "space_requirement", "birth_rate", "death_rate", "migration_rate", "disease_rate", "predation_rate", "carrying_capacity", "genetic_diversity_proxy", "generation", "population_status", "reproduction_modes", "cooldown_ticks", "traits"],
      "properties": {
        "population_id": { "type": "string", "minLength": 1 },
        "species_id": { "enum": ["SPECIES-KAIOS-FOUNDATIONAL-GRASS", "SPECIES-KAIOS-FOUNDATIONAL-TREE", "SPECIES-KAIOS-FOUNDATIONAL-FISH", "SPECIES-KAIOS-FOUNDATIONAL-SHRIMP", "SPECIES-KAIOS-FOUNDATIONAL-MOUNTAIN", "SPECIES-KAIOS-FOUNDATIONAL-SOIL", "SPECIES-KAIOS-FOUNDATIONAL-WATER", "SPECIES-KAIOS-FOUNDATIONAL-RIVER"] },
        "habitat_id": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0, "maximum": 500 },
        "age_distribution": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "sex_distribution": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "health_distribution": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "energy_reserve": { "type": "number", "minimum": 0 },
        "food_requirement": { "type": "number", "minimum": 0 },
        "water_requirement": { "type": "number", "minimum": 0 },
        "space_requirement": { "type": "number", "minimum": 0 },
        "birth_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "death_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "migration_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "disease_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "predation_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "carrying_capacity": { "type": "integer", "minimum": 0, "maximum": 500 },
        "genetic_diversity_proxy": { "type": "number", "minimum": 0, "maximum": 1 },
        "generation": { "type": "integer", "minimum": 0, "maximum": 100 },
        "population_status": { "$ref": "#/$defs/populationStatus" },
        "reproduction_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reproductionMode" } },
        "cooldown_ticks": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "traits": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["water_l", "atmospheric_water_l", "exported_water_l", "restoration_water_reserve_l", "mountain_snowpack_l", "biomass_kg", "consumer_biomass_kg", "exported_biomass_kg", "nutrients_kg", "restoration_nutrient_reserve_kg", "dead_biomass_kg", "decomposition_kg", "aquatic_primary_food_kg", "detritus_kg", "sediment_kg", "energy_proxy"],
      "properties": {
        "water_l": { "type": "number", "minimum": 0 },
        "atmospheric_water_l": { "type": "number", "minimum": 0 },
        "exported_water_l": { "type": "number", "minimum": 0 },
        "restoration_water_reserve_l": { "type": "number", "minimum": 0 },
        "mountain_snowpack_l": { "type": "number", "minimum": 0 },
        "biomass_kg": { "type": "number", "minimum": 0 },
        "consumer_biomass_kg": { "type": "number", "minimum": 0 },
        "exported_biomass_kg": { "type": "number", "minimum": 0 },
        "nutrients_kg": { "type": "number", "minimum": 0 },
        "restoration_nutrient_reserve_kg": { "type": "number", "minimum": 0 },
        "dead_biomass_kg": { "type": "number", "minimum": 0 },
        "decomposition_kg": { "type": "number", "minimum": 0 },
        "aquatic_primary_food_kg": { "type": "number", "minimum": 0 },
        "detritus_kg": { "type": "number", "minimum": 0 },
        "sediment_kg": { "type": "number", "minimum": 0 },
        "energy_proxy": { "type": "number", "minimum": 0 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "object" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "type", "location", "simulation_time", "status", "source", "authority", "simulation_only", "history", "previous_state_hash", "next_state_hash", "inputs", "outputs", "resource_delta", "reason"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["REPRODUCTION_EVENT", "BIRTH_EVENT", "DEATH_EVENT", "MIGRATION_EVENT", "PREDATION_EVENT", "COMPETITION_EVENT", "DISEASE_EVENT", "POLLUTION_EVENT", "RESTORATION_EVENT", "SEASON_EVENT", "GROWTH_EVENT", "DECOMPOSITION_EVENT", "WATER_CYCLE_EVENT", "SOIL_CYCLE_EVENT"] },
        "location": { "type": "string" },
        "simulation_time": { "type": "integer", "minimum": 0 },
        "status": { "type": "string" },
        "source": { "type": "string" },
        "authority": { "const": "SIMULATION_ONLY" },
        "simulation_only": { "const": true },
        "history": { "type": "array" },
        "previous_state_hash": { "type": "string" },
        "next_state_hash": { "type": "string" },
        "inputs": { "type": "object" },
        "outputs": { "type": "object" },
        "resource_delta": { "type": "object" },
        "reason": { "type": "string" }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_only", "wallet", "real_kgen", "onchain_transfer", "real_bioengineering", "production_authority", "automatic_new_species", "uncontrolled_reproduction", "public_mutation_endpoints", "maximum_total_population"],
      "properties": {
        "simulation_only": { "const": true },
        "wallet": { "const": "NONE" },
        "real_kgen": { "const": "NO_REAL_KGEN" },
        "onchain_transfer": { "const": false },
        "real_bioengineering": { "const": false },
        "production_authority": { "const": false },
        "automatic_new_species": { "const": false },
        "uncontrolled_reproduction": { "const": false },
        "public_mutation_endpoints": { "const": false },
        "maximum_total_population": { "const": 500 }
      }
    }
  }
}
