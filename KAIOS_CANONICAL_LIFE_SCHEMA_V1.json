{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "KAIOS_CANONICAL_LIFE_SCHEMA_V1.json",
  "title": "KAIOS Canonical Life Schema V1",
  "description": "Universal specification-only contract composed as SHARED_CORE + APPROVED_TYPE_EXTENSION.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "life_type", "life_id", "species_id", "display_name", "scientific_or_system_name", "taxonomy", "origin", "birth_or_formation_record", "location", "mass", "volume", "density", "dimensions", "material_composition", "energy_model", "resource_inputs", "resource_outputs", "environment_requirements", "growth_or_development", "aging", "health_or_integrity", "damage", "repair_or_healing", "reproduction_or_replication", "mutation_or_change", "death_or_termination", "history", "rights", "authority", "ownership", "custody", "operation", "usage", "transfer", "economic_role", "civilization_role", "runtime_binding", "world_viewer_binding", "api_binding", "provenance", "integrity", "deterministic_seed", "event_log", "field_applicability", "extensions", "safety_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "life_type": { "$ref": "#/$defs/lifeType" },
    "life_id": { "type": "string", "pattern": "^LIFE-[A-Z0-9][A-Z0-9_-]+$" },
    "species_id": { "type": ["string", "null"] },
    "display_name": { "type": "string", "minLength": 1 },
    "scientific_or_system_name": { "type": "string", "minLength": 1 },
    "taxonomy": { "$ref": "#/$defs/taxonomy" },
    "origin": { "$ref": "#/$defs/record" },
    "birth_or_formation_record": { "$ref": "#/$defs/record" },
    "location": { "$ref": "#/$defs/record" },
    "mass": { "$ref": "#/$defs/measure" },
    "volume": { "$ref": "#/$defs/measure" },
    "density": { "$ref": "#/$defs/measure" },
    "dimensions": { "$ref": "#/$defs/record" },
    "material_composition": { "$ref": "#/$defs/record" },
    "energy_model": { "$ref": "#/$defs/record" },
    "resource_inputs": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "resource_outputs": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "environment_requirements": { "$ref": "#/$defs/record" },
    "growth_or_development": { "$ref": "#/$defs/record" },
    "aging": { "$ref": "#/$defs/record" },
    "health_or_integrity": { "$ref": "#/$defs/record" },
    "damage": { "$ref": "#/$defs/record" },
    "repair_or_healing": { "$ref": "#/$defs/record" },
    "reproduction_or_replication": { "$ref": "#/$defs/record" },
    "mutation_or_change": { "$ref": "#/$defs/record" },
    "death_or_termination": { "$ref": "#/$defs/record" },
    "history": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "rights": { "$ref": "#/$defs/rights" },
    "authority": { "$ref": "#/$defs/record" },
    "ownership": { "$ref": "#/$defs/record" },
    "custody": { "$ref": "#/$defs/record" },
    "operation": { "$ref": "#/$defs/record" },
    "usage": { "$ref": "#/$defs/record" },
    "transfer": { "$ref": "#/$defs/record" },
    "economic_role": { "$ref": "#/$defs/economy" },
    "civilization_role": { "$ref": "#/$defs/record" },
    "runtime_binding": { "$ref": "#/$defs/binding" },
    "world_viewer_binding": { "$ref": "#/$defs/binding" },
    "api_binding": { "$ref": "#/$defs/binding" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "deterministic_seed": { "type": "string", "minLength": 1 },
    "event_log": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "field_applicability": { "$ref": "#/$defs/applicabilityMap" },
    "extensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/extension" } },
    "safety_boundaries": { "$ref": "#/$defs/safety" }
  },
  "allOf": [
    { "if": { "properties": { "life_type": { "const": "BIOLOGICAL_LIFE" } }, "required": ["life_type"] }, "then": { "properties": { "extensions": { "contains": { "properties": { "extension_id": { "enum": ["PLANT_EXTENSION", "ANIMAL_EXTENSION", "MARINE_EXTENSION", "MICROBIAL_EXTENSION"] } }, "required": ["extension_id"] }, "items": { "properties": { "extension_id": { "enum": ["PLANT_EXTENSION", "ANIMAL_EXTENSION", "MARINE_EXTENSION", "MICROBIAL_EXTENSION"] } } } } } } },
    { "if": { "properties": { "life_type": { "const": "DIGITAL_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/digitalExtensions" } },
    { "if": { "properties": { "life_type": { "const": "ROBOTIC_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/roboticExtensions" } },
    { "if": { "properties": { "life_type": { "const": "PLANT_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/plantExtensions" } },
    { "if": { "properties": { "life_type": { "const": "ANIMAL_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/animalExtensions" } },
    { "if": { "properties": { "life_type": { "const": "MARINE_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/marineExtensions" } },
    { "if": { "properties": { "life_type": { "const": "MICROBIAL_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/microbialExtensions" } },
    { "if": { "properties": { "life_type": { "const": "TERRAIN_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/terrainExtensions" } },
    { "if": { "properties": { "life_type": { "const": "WATER_BODY_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/waterBodyExtensions" } },
    { "if": { "properties": { "life_type": { "const": "LAND_LIFE" } }, "required": ["life_type"] }, "then": { "properties": { "extensions": { "contains": { "properties": { "extension_id": { "const": "LAND_EXTENSION" } }, "required": ["extension_id"] }, "items": { "properties": { "extension_id": { "enum": ["LAND_EXTENSION", "SOIL_EXTENSION", "TERRAIN_EXTENSION"] } } } } } } },
    { "if": { "properties": { "life_type": { "const": "BUILDING_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/buildingExtensions" } },
    { "if": { "properties": { "life_type": { "const": "INFRASTRUCTURE_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/infrastructureExtensions" } },
    { "if": { "properties": { "life_type": { "const": "COMPANY_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/companyExtensions" } },
    { "if": { "properties": { "life_type": { "const": "CITY_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/cityExtensions" } },
    { "if": { "properties": { "life_type": { "const": "PLANET_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/planetExtensions" } },
    { "if": { "properties": { "life_type": { "const": "TEMPLE_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/templeExtensions" } },
    { "if": { "properties": { "life_type": { "const": "UNIVERSE_LIFE" } }, "required": ["life_type"] }, "then": { "$ref": "#/$defs/universeExtensions" } }
  ],
  "$defs": {
    "lifeType": { "enum": ["BIOLOGICAL_LIFE", "DIGITAL_LIFE", "ROBOTIC_LIFE", "PLANT_LIFE", "ANIMAL_LIFE", "MARINE_LIFE", "MICROBIAL_LIFE", "TERRAIN_LIFE", "WATER_BODY_LIFE", "LAND_LIFE", "BUILDING_LIFE", "INFRASTRUCTURE_LIFE", "COMPANY_LIFE", "CITY_LIFE", "PLANET_LIFE", "TEMPLE_LIFE", "UNIVERSE_LIFE"] },
    "applicability": { "enum": ["REQUIRED", "OPTIONAL", "NOT_APPLICABLE"] },
    "record": { "type": "object", "additionalProperties": true },
    "measure": { "type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": { "value": { "type": ["number", "null"] }, "unit": { "type": ["string", "null"] } } },
    "taxonomy": { "type": "object", "additionalProperties": true, "required": ["DOMAIN", "KINGDOM", "PHYLUM", "CLASS", "ORDER", "FAMILY", "GENUS", "SPECIES", "LIFE_INSTANCE"], "properties": { "DOMAIN": { "type": "string" }, "KINGDOM": { "type": "string" }, "PHYLUM": { "type": "string" }, "CLASS": { "type": "string" }, "ORDER": { "type": "string" }, "FAMILY": { "type": "string" }, "GENUS": { "type": "string" }, "SPECIES": { "type": "string" }, "LIFE_INSTANCE": { "type": "string" }, "extension_19": { "type": "object" } } },
    "rights": { "type": "object", "additionalProperties": false, "required": ["OWNER", "CUSTODIAN", "OPERATOR", "OCCUPANT", "USAGE_RIGHTS", "HARVEST_RIGHTS", "BREEDING_RIGHTS", "COMMERCIAL_LICENSE", "TRANSFER_RIGHTS", "HABITAT_RIGHTS", "CONTROL_AUTHORITY", "tradeability"], "properties": { "OWNER": { "$ref": "#/$defs/record" }, "CUSTODIAN": { "$ref": "#/$defs/record" }, "OPERATOR": { "$ref": "#/$defs/record" }, "OCCUPANT": { "$ref": "#/$defs/record" }, "USAGE_RIGHTS": { "$ref": "#/$defs/record" }, "HARVEST_RIGHTS": { "$ref": "#/$defs/record" }, "BREEDING_RIGHTS": { "$ref": "#/$defs/record" }, "COMMERCIAL_LICENSE": { "$ref": "#/$defs/record" }, "TRANSFER_RIGHTS": { "$ref": "#/$defs/record" }, "HABITAT_RIGHTS": { "$ref": "#/$defs/record" }, "CONTROL_AUTHORITY": { "$ref": "#/$defs/record" }, "tradeability": { "enum": ["NOT_TRADEABLE", "RIGHTS_ONLY", "RESOURCE_UNIT", "DIGITAL_PACKAGE", "SIMULATED_LISTING", "FUTURE_REVIEW_REQUIRED"] } } },
    "economy": { "type": "object", "additionalProperties": false, "required": ["economic_value", "resource_value", "labor_requirement", "maintenance_cost", "harvest_or_output", "market_role", "supply_chain_inputs", "supply_chain_outputs", "civilization_requirement", "technology_requirement", "K11520_eligibility", "rights_package", "value_basis"], "properties": { "economic_value": {}, "resource_value": {}, "labor_requirement": {}, "maintenance_cost": {}, "harvest_or_output": {}, "market_role": {}, "supply_chain_inputs": { "type": "array" }, "supply_chain_outputs": { "type": "array" }, "civilization_requirement": {}, "technology_requirement": {}, "K11520_eligibility": { "const": "SIMULATED_K11520_ONLY" }, "rights_package": {}, "value_basis": { "type": "string", "minLength": 1 } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["mode", "reference", "authority"], "properties": { "mode": { "enum": ["NONE", "READ_ONLY", "LOCAL_DETERMINISTIC_SIMULATION", "NON_EXECUTABLE_BINDING"] }, "reference": { "type": ["string", "null"] }, "authority": { "const": "NO_PRODUCTION_AUTHORITY" } } },
    "provenance": { "type": "object", "required": ["source", "created_at", "author", "source_commit"], "properties": { "source": { "type": "string" }, "created_at": { "type": "string" }, "author": { "type": "string" }, "source_commit": { "type": "string" } } },
    "integrity": { "type": "object", "additionalProperties": false, "required": ["algorithm", "checksum", "covers"], "properties": { "algorithm": { "const": "SHA-256" }, "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "covers": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "event": { "type": "object", "required": ["event_id", "timestamp", "type", "status", "previous_state_hash", "next_state_hash"], "properties": { "event_id": { "type": "string" }, "timestamp": { "type": "string" }, "type": { "type": "string" }, "status": { "type": "string" }, "previous_state_hash": { "type": ["string", "null"] }, "next_state_hash": { "type": "string" } } },
    "applicabilityMap": { "type": "object", "minProperties": 44, "maxProperties": 44, "propertyNames": { "enum": ["schema_version", "life_type", "life_id", "species_id", "display_name", "scientific_or_system_name", "taxonomy", "origin", "birth_or_formation_record", "location", "mass", "volume", "density", "dimensions", "material_composition", "energy_model", "resource_inputs", "resource_outputs", "environment_requirements", "growth_or_development", "aging", "health_or_integrity", "damage", "repair_or_healing", "reproduction_or_replication", "mutation_or_change", "death_or_termination", "history", "rights", "authority", "ownership", "custody", "operation", "usage", "transfer", "economic_role", "civilization_role", "runtime_binding", "world_viewer_binding", "api_binding", "provenance", "integrity", "deterministic_seed", "event_log"] }, "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": { "status": { "$ref": "#/$defs/applicability" }, "reason": { "type": "string", "minLength": 1 } } } },
    "extension": { "type": "object", "additionalProperties": false, "required": ["extension_id", "schema_version", "data"], "properties": { "extension_id": { "enum": ["PLANT_EXTENSION", "ANIMAL_EXTENSION", "MARINE_EXTENSION", "MICROBIAL_EXTENSION", "TERRAIN_EXTENSION", "WATER_BODY_EXTENSION", "SOIL_EXTENSION", "BUILDING_EXTENSION", "INFRASTRUCTURE_EXTENSION", "COMPANY_EXTENSION", "CITY_EXTENSION", "PLANET_EXTENSION", "TEMPLE_EXTENSION", "UNIVERSE_EXTENSION", "DIGITAL_EXTENSION", "ROBOTIC_EXTENSION", "LAND_EXTENSION"] }, "schema_version": { "const": "1.0.0" }, "data": { "type": "object", "minProperties": 1 } } },
    "safety": { "type": "object", "additionalProperties": false, "required": ["real_kgen", "onchain_transfer", "k11520", "production_runtime", "wallet", "legal_personhood"], "properties": { "real_kgen": { "const": "NO_REAL_KGEN" }, "onchain_transfer": { "const": "NO_ONCHAIN_TRANSFER" }, "k11520": { "const": "SIMULATED_K11520_ONLY" }, "production_runtime": { "const": false }, "wallet": { "const": "NONE" }, "legal_personhood": { "const": false } } },
    "singleExtension": { "type": "object", "properties": { "extensions": { "type": "array", "minItems": 1, "maxItems": 1 } } },
    "digitalExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "DIGITAL_EXTENSION" } } } } } }] },
    "roboticExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "ROBOTIC_EXTENSION" } } } } } }] },
    "plantExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "PLANT_EXTENSION" } } } } } }] },
    "animalExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "ANIMAL_EXTENSION" } } } } } }] },
    "marineExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "MARINE_EXTENSION" } } } } } }] },
    "microbialExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "MICROBIAL_EXTENSION" } } } } } }] },
    "terrainExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "TERRAIN_EXTENSION" } } } } } }] },
    "waterBodyExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "WATER_BODY_EXTENSION" } } } } } }] },
    "buildingExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "BUILDING_EXTENSION" } } } } } }] },
    "infrastructureExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "INFRASTRUCTURE_EXTENSION" } } } } } }] },
    "companyExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "COMPANY_EXTENSION" } } } } } }] },
    "cityExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "CITY_EXTENSION" } } } } } }] },
    "planetExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "PLANET_EXTENSION" } } } } } }] },
    "templeExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "TEMPLE_EXTENSION" } } } } } }] },
    "universeExtensions": { "allOf": [{ "$ref": "#/$defs/singleExtension" }, { "properties": { "extensions": { "items": { "properties": { "extension_id": { "const": "UNIVERSE_EXTENSION" } } } } } }] }
  }
}
